# ==============================================================================
# IntentLock — Approval-Aware Purchasing Agent & Cryptographic PayPal Checkout
# Environment Configuration Template (.env.example)
# Copy this file to `backend/.env` or root `.env` to configure live providers.
# Note: You can also configure or switch keys at runtime directly from the
# top-right "LLM Router & PayPal Keys" modal in the React UI!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Security Settings
# ------------------------------------------------------------------------------
APP_NAME="IntentLock API"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./intentlock.db"

# Cryptographic Signing Secrets (Used for JWT RBAC Persona Tokens & HMAC-SHA256 ApprovalLocks)
JWT_SECRET_KEY="intentlock-dev-jwt-secret-change-in-production"
APPROVAL_HMAC_SECRET="intentlock-dev-hmac-approval-secret-change-in-production"
APPROVAL_DEFAULT_TTL_MINUTES=15

# Single-Merchant & Currency Policy (Hard Guardrails G-01, G-02, G-03)
MERCHANT_ID="MERCH-ACME-001"
MERCHANT_NAME="Acme Workspace & Event Supply Co."
CURRENCY="USD"

# ------------------------------------------------------------------------------
# 2. Multi-LLM Automatic Failover Router Credentials (Priority 1 -> 5)
# ------------------------------------------------------------------------------
# IntentLock includes a 4-tier live LLM failover router plus a Priority-5
# deterministic catalog rule engine so demos and tests NEVER fail due to rate limits.

# Priority 1: Google Gemini (Default model: gemini-2.5-flash)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Priority 2: Groq Cloud (Default model: llama-3.3-70b-versatile)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Priority 3: xAI Grok (Default model: grok-2-latest)
# Get an API key at: https://console.x.ai/
XAI_API_KEY=""
XAI_MODEL="grok-2-latest"

# Priority 4A: OpenRouter (Default model: meta-llama/llama-3.3-70b-instruct)
# Get an API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# Priority 4B: OpenAI (Default model: gpt-4o-mini)
# Get an API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Router Circuit-Breaker Tuning
LLM_TIMEOUT_SECONDS=12.0
LLM_CIRCUIT_BREAKER_THRESHOLD=2
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 3. PayPal Sandbox Orders v2 & Official PayPal MCP Server Integration
# ------------------------------------------------------------------------------
# Create free PayPal Developer Sandbox REST credentials at:
# https://developer.paypal.com/dashboard/applications/sandbox
# Official PayPal MCP Server Reference: https://mcp.paypal.com
# (Leave blank to run with the deterministic PayPal Sandbox MCP protocol bridge)
PAYPAL_MODE="sandbox"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MCP_ENABLED=true
